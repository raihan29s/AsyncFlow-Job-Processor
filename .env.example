# Database Configuration
DATABASE_URL=postgresql://asyncflow:asyncflow123@localhost:5432/asyncflow_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/asyncflow-jobs
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/asyncflow-jobs-dlq

# Application Settings
APP_NAME=AsyncFlow Job Processor
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
DEBUG=False
ENVIRONMENT=development

# Worker Configuration
WORKERS_COUNT=4
MAX_CONCURRENT_JOBS=10
POLL_INTERVAL=5
VISIBILITY_TIMEOUT=300
MAX_RETRIES=3
RETRY_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY=your-api-key-for-client-authentication
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
NOTIFICATION_FROM_EMAIL=noreply@asyncflow.com
NOTIFICATION_FROM_NAME=AsyncFlow Notifications

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (Optional - for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Job Configuration
JOB_TIMEOUT=3600
MAX_JOB_SIZE_MB=100

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=
